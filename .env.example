# Application
NODE_ENV=development
PORT=3000
APP_NAME=OpsCtrl Sample App

# Database — OpsCtrl provisions this automatically on deploy
# All values below are the defaults; no changes needed for local dev with docker-compose
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=sample_app
# Or use a full URL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/sample_app

# Redis — OpsCtrl provisions this automatically on deploy
REDIS_URL=redis://localhost:6379
