# Application
NODE_ENV=development
PORT=3000
APP_NAME=NestJS Backend Template
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
CLIENT_SIDE_URL=http://localhost:3000
# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=template_db
# Or use DATABASE_URL instead:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/template_db

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_HASH_ROUNDS=10

# AI Providers (Optional - comment out if not needed)
LLM_PROVIDER=claude
EMBEDDINGS_PROVIDER=openai

# Anthropic/Claude (required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI (required for embeddings or if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-openai-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536

# Email Notifications (Optional)
NOTIFICATION_MODULE_ENABLED=true
GOOGLE_WORKSPACE_SMTP_HOST=smtp.gmail.com
GOOGLE_WORKSPACE_SMTP_PORT=587
GOOGLE_WORKSPACE_EMAIL_USERNAME=your-email@gmail.com
GOOGLE_WORKSPACE_EMAIL_PASSWORD=your-app-password
NOTIFICATION_FROM_EMAIL=noreply@example.com
NOTIFICATION_FROM_NAME=NestJS Template

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UNAUTH_MAX=100
RATE_LIMIT_UNAUTH_WINDOW=60
RATE_LIMIT_AUTH_MAX=1000
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_SKIP_PATHS=/health,/metrics

# Logging
LOG_LEVEL=info
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=false
LOG_ENABLE_JSON=false
LOG_ENABLE_REQUESTS=true
LOG_ENABLE_PERFORMANCE=false
LOG_ENABLE_AUDIT=false
